# Copy this file to .env and edit it. Never commit .env.
DOMAIN=app.example.com
BASIC_AUTH_USER=bookcast
# Generate with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-long-password'
# Keep the single quotes so the $ characters survive shell/Compose handling.
BASIC_AUTH_HASH='$2a$14$replace-with-a-real-caddy-hash'
TZ=UTC

# Optional second layer of app-level basic auth. Caddy already protects the
# public site; leave these blank unless you want the app to prompt as well.
# BOOKCAST_USER=
# BOOKCAST_PASSWORD=
